# Local development defaults. Copy to .env; never commit .env or real credentials.
PORT=8787
HOST=127.0.0.1
NODE_ENV=development
APP_URL=http://localhost:5173
FRONTEND_ORIGIN=http://localhost:5173

# Local development may leave these blank to use SQLite.
# Vercel/production requires hosted PostgreSQL via DATABASE_URL and DIRECT_URL.
DATABASE_URL=
DIRECT_URL=

# Production requires distinct random values of at least 32 characters.
JWT_ACCESS_SECRET=
TOKEN_HASH_SECRET=

# Optional external services (server-side only)
SERPAPI_KEY=
LLM_API_KEY=
LLM_API_URL=https://api.openai.com/v1/chat/completions
LLM_MODEL=gpt-4o-mini
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Say it. See it. <no-reply@example.com>
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
BLOB_READ_WRITE_TOKEN=
REDIS_URL=

# Safe browser configuration only. Do not put secrets in VITE_* variables.
VITE_API_BASE_URL=/api
